{
  "_doc": "Golden vectors for DINCR's CRC/USD conversion contract. The rate is always CRC per 1 USD and is entered by the user; DINCR never invents one. Every helper that turns an amount typed or detected in one currency into an account's base currency must produce exactly these results (see test_currency_conversion_contract.py). A vector with a 'target' pins a storage limit of that destination only: 'transactions' (mail and statement candidates; production transactions.amount/original_amount NUMERIC(12,2), exchange_rate NUMERIC(12,6)) or 'entries' (manual income and expenses; salaries/expenses NUMERIC(14,2) and NUMERIC(14,6)). Every other vector applies to both. Synthetic values only.",
  "vectors": [
    {"case": "CRC to CRC", "currency": "CRC", "amount": 18500, "base": "CRC", "rate": null, "expect": {"amount": "18500.00", "original_amount": null, "original_currency": null, "exchange_rate": null}},
    {"case": "CRC to CRC ignores a rate", "currency": "CRC", "amount": 18500, "base": "CRC", "rate": 505, "expect": {"amount": "18500.00", "original_amount": null, "original_currency": null, "exchange_rate": null}},
    {"case": "USD to USD", "currency": "USD", "amount": 21, "base": "USD", "rate": null, "expect": {"amount": "21.00", "original_amount": null, "original_currency": null, "exchange_rate": null}},
    {"case": "USD to CRC", "currency": "USD", "amount": 21, "base": "CRC", "rate": 505, "expect": {"amount": "10605.00", "original_amount": "21.00", "original_currency": "USD", "exchange_rate": "505.000000"}},
    {"case": "USD to CRC, the unconverted MultiMoney shape", "currency": "USD", "amount": 50, "base": "CRC", "rate": 500, "expect": {"amount": "25000.00", "original_amount": "50.00", "original_currency": "USD", "exchange_rate": "500.000000"}},
    {"case": "CRC to USD keeps the same rate definition", "currency": "CRC", "amount": 50500, "base": "USD", "rate": 505, "expect": {"amount": "100.00", "original_amount": "50500.00", "original_currency": "CRC", "exchange_rate": "505.000000"}},
    {"case": "missing rate, USD to CRC", "currency": "USD", "amount": 21, "base": "CRC", "rate": null, "expect": {"status": 422}},
    {"case": "missing rate, CRC to USD", "currency": "CRC", "amount": 18500, "base": "USD", "rate": null, "expect": {"status": 422}},
    {"case": "invalid rate, zero", "currency": "USD", "amount": 21, "base": "CRC", "rate": 0, "expect": {"status": 422}},
    {"case": "invalid rate, negative", "currency": "USD", "amount": 21, "base": "CRC", "rate": -505, "expect": {"status": 422}},
    {"case": "invalid rate, rounds to zero at the stored precision", "currency": "CRC", "amount": 18500, "base": "USD", "rate": 1e-07, "expect": {"status": 422}},
    {"case": "rounding, typed amount half up to cents", "currency": "USD", "amount": 10.005, "base": "CRC", "rate": 505, "expect": {"amount": "5055.05", "original_amount": "10.01", "original_currency": "USD", "exchange_rate": "505.000000"}},
    {"case": "rounding, CRC to USD half up", "currency": "CRC", "amount": 100, "base": "USD", "rate": 505, "expect": {"amount": "0.20", "original_amount": "100.00", "original_currency": "CRC", "exchange_rate": "505.000000"}},
    {"case": "rounding, computed with the rate as stored (6 decimals)", "currency": "USD", "amount": 100000, "base": "CRC", "rate": 505.12345649, "expect": {"amount": "50512345.60", "original_amount": "100000.00", "original_currency": "USD", "exchange_rate": "505.123456"}},
    {"case": "rounding, converted below one cent", "currency": "CRC", "amount": 1, "base": "USD", "rate": 505, "expect": {"status": 422}},
    {"case": "overflow, typed amount", "currency": "CRC", "amount": 1000000000000, "base": "CRC", "rate": null, "expect": {"status": 422}},
    {"case": "overflow, converted amount", "currency": "USD", "amount": 999999999999.99, "base": "CRC", "rate": 505, "expect": {"status": 422}},
    {"case": "largest storable amount, NUMERIC(14,2)", "currency": "USD", "amount": 999999999999.99, "base": "USD", "rate": null, "expect": {"amount": "999999999999.99", "original_amount": null, "original_currency": null, "exchange_rate": null}, "target": "entries"},
    {"case": "legacy base cannot convert", "currency": "CRC", "amount": 100, "base": "EUR", "rate": 505, "expect": {"status": 422}},
    {"case": "legacy currency cannot convert", "currency": "EUR", "amount": 100, "base": "CRC", "rate": 505, "expect": {"status": 422}},
    {"case": "legacy base in its own currency", "currency": "EUR", "amount": 100, "base": "EUR", "rate": null, "expect": {"amount": "100.00", "original_amount": null, "original_currency": null, "exchange_rate": null}},
    {"case": "largest storable amount, NUMERIC(12,2)", "target": "transactions", "currency": "CRC", "amount": 9999999999.99, "base": "CRC", "rate": null, "expect": {"amount": "9999999999.99", "original_amount": null, "original_currency": null, "exchange_rate": null}},
    {"case": "overflow, one cent above NUMERIC(12,2)", "target": "transactions", "currency": "CRC", "amount": 10000000000.0, "base": "CRC", "rate": null, "expect": {"status": 422}},
    {"case": "overflow, typed amount that rounds above NUMERIC(12,2)", "target": "transactions", "currency": "USD", "amount": "9999999999.995", "base": "USD", "rate": null, "expect": {"status": 422}},
    {"case": "rounding, typed amount that rounds down into NUMERIC(12,2)", "target": "transactions", "currency": "USD", "amount": "9999999999.994", "base": "USD", "rate": null, "expect": {"amount": "9999999999.99", "original_amount": null, "original_currency": null, "exchange_rate": null}},
    {"case": "overflow, converted amount above NUMERIC(12,2) (fits NUMERIC(14,2))", "target": "transactions", "currency": "USD", "amount": 20000000, "base": "CRC", "rate": 505, "expect": {"status": 422}},
    {"case": "largest storable rate, NUMERIC(12,6)", "target": "transactions", "currency": "CRC", "amount": 1000000, "base": "USD", "rate": "999999.999999", "expect": {"amount": "1.00", "original_amount": "1000000.00", "original_currency": "CRC", "exchange_rate": "999999.999999"}},
    {"case": "invalid rate, above NUMERIC(12,6)", "target": "transactions", "currency": "CRC", "amount": 1000000, "base": "USD", "rate": 1000000, "expect": {"status": 422}},
    {"case": "invalid rate, rounds above NUMERIC(12,6)", "target": "transactions", "currency": "CRC", "amount": 1000000, "base": "USD", "rate": "999999.9999995", "expect": {"status": 422}},
    {"case": "rounding, rate that rounds down into NUMERIC(12,6)", "target": "transactions", "currency": "CRC", "amount": 1000000, "base": "USD", "rate": "999999.9999994", "expect": {"amount": "1.00", "original_amount": "1000000.00", "original_currency": "CRC", "exchange_rate": "999999.999999"}},
    {"case": "invalid rate, far beyond any column", "target": "transactions", "currency": "USD", "amount": 21, "base": "CRC", "rate": 1e+30, "expect": {"status": 422}},
    {"case": "invalid amount, far beyond any column", "target": "transactions", "currency": "USD", "amount": 1e+300, "base": "USD", "rate": null, "expect": {"status": 422}}
  ]
}
